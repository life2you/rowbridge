{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RowBridge",
  "version": "0.4.0",
  "identifier": "com.rowbridge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RowBridge",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "copyright": "MIT License",
    "category": "DeveloperTool",
    "shortDescription": "MySQL 可视化同步工具",
    "longDescription": "RowBridge 是一个 macOS 端的 MySQL 数据同步工具：按单列整型主键分批搬运数据，目标表不存在时按源表结构自动创建。"
  }
}
